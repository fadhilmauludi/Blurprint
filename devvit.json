{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "blurprint",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "tall",
        "styles": {
          "backgroundColor": "#0B3D91FF",
          "backgroundColorDark": "#0B3D91FF"
        }
      },
      "game": {
        "entry": "game.html",
        "styles": {
          "backgroundColor": "#0B3D91FF",
          "backgroundColorDark": "#0B3D91FF"
        }
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "journeys": true,
    "reddit": {
      "enable": true,
      "asUser": ["SUBSCRIBE_TO_SUBREDDIT"]
    }
  },
  "scheduler": {
    "tasks": {
      "daily-rollover": {
        "endpoint": "/internal/scheduler/daily-rollover",
        "cron": "0 0 * * *"
      },
      "rollover-safety-net": {
        "endpoint": "/internal/scheduler/daily-rollover",
        "cron": "15 * * * *"
      },
      "purge-sweep": {
        "endpoint": "/internal/scheduler/purge-sweep",
        "cron": "37 * * * *"
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Blurprint: create today's post now",
        "description": "Manual rollover / recovery",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-today"
      },
      {
        "label": "Blurprint: hide or show a day's blend",
        "description": "For coordinated rude shapes",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/hide-blend"
      },
      {
        "label": "Blurprint: load seed data",
        "description": "Seed drawings for pre-launch days",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/load-seed"
      },
      {
        "label": "Blurprint: reset launch epoch (dev)",
        "description": "Makes today Day 1 — dev subreddits only",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reset-epoch"
      }
    ]
  },
  "forms": {
    "hideBlendForm": "/internal/form/hide-blend",
    "seedForm": "/internal/form/seed",
    "resetEpochForm": "/internal/form/reset-epoch"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
